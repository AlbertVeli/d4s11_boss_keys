// Flowchart of material sources and uses in D4 Season 11 Lairs and Azmodan Hoards
// (Mainly generated by ChatGPT)
// Font: Nunito (https://github.com/googlefonts/NunitoSans)
// Install the font locally or change the fontname attributes

digraph D4S11_BlockFlow {
  graph [
    rankdir=TB,
    splines=ortho,
    nodesep=0.8,
    ranksep=1.1,
    pad="0.2",
    bgcolor="white",
    fontname="Nunito",
    fontsize=12
  ];

  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#ffffff",
    color="#2f2f2f",
    penwidth=1.2,
    fontname="Nunito",
    fontsize=11,
    margin="0.22,0.18"
  ];

  edge [
    color="#2f2f2f",
    penwidth=1.1,
    arrowsize=0.75,
    fontname="Nunito",
    fontsize=10
  ];

  Activities [
    label=<
      <B>Activities</B><BR ALIGN="LEFT"/>
      Helltides → Living Steel<BR ALIGN="LEFT"/>
      Whispers → Malignant Heart<BR ALIGN="LEFT"/>
      NMDs → Distilled Fear<BR ALIGN="LEFT"/>
      World Bosses → Exquisite Blood / Judicator's Mask<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      (Also: keys may drop from other endgame activities)
    >,
    fillcolor="#f6f6f6"
  ];

  // Add some spacing first for the bounding box
  // to be large enough to fit all labels
  Initiate [
    label=<
      <BR/>
      <B>Initiate Lair Bosses</B><BR ALIGN="LEFT"/>
      Grigoire (Living Steel)<BR ALIGN="LEFT"/>
      Varshan (Malignant Heart)<BR ALIGN="LEFT"/>
      Lord Zir (Exquisite Blood)<BR ALIGN="LEFT"/>
      Urivar (Judicator's Mask)<BR ALIGN="LEFT"/>
      Beast in the Ice (Distilled Fear)<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      <B>Drops (used next):</B><BR ALIGN="LEFT"/>
      Shard of Agony / Pincushioned Doll / Abhorrent Heart
    >,
    fillcolor="#eef6ff"
  ];

  Greater [
  label=<
      <BR/>
      <B>Greater Lair Bosses</B><BR ALIGN="LEFT"/>
      Duriel / Andariel / Harbinger / Belial<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      <B>Drops:</B><BR ALIGN="LEFT"/>
      Corrupted Horns / Eyes / Claws<BR ALIGN="LEFT"/>
      Corrupted Essence (for Azmodan)
    >,
    fillcolor="#fff4e6"
  ];

  Azmodan [
    label=<
      <BR/>
      <B>Azmodan</B><BR ALIGN="LEFT"/>
      Summon with 1 Corrupted Essence:<BR ALIGN="LEFT"/>
      Duriel's / Andariel's / Belial's<BR ALIGN="LEFT"/>
      <BR ALIGN="LEFT"/>
      Open Hoard with 5 Corrupted Horns / Claws / Eyes<BR ALIGN="LEFT"/>
    >,
    fillcolor="#ffeef2"
  ];

  Outputs [
    label=<
      <B>Azmodan Hoards → Outputs</B><BR ALIGN="LEFT"/>
      Lair keys (all tiers)<BR ALIGN="LEFT"/>
      Nightmare Dungeon keys<BR ALIGN="LEFT"/>
      Keys to other activities:<BR ALIGN="LEFT"/>
      Kurast Undercity, Infernal Hordes, The Pit, The Tower
    >,
    fillcolor="#f7fff0"
  ];

  // Main flow arrows
  Activities -> Initiate [xlabel="farmed materials & keys"];
  Initiate   -> Greater  [xlabel="drops"];
  Greater    -> Azmodan  [xlabel="corrupted drops"];
  Azmodan    -> Outputs  [xlabel="hoards"];
  Outputs    -> Initiate [color="#777777", style=dashed, constraint=false, xlabel="initiate lair keys"];
  Outputs    -> Greater  [color="#777777", style=dashed, constraint=false, xlabel="greater lair keys"];
}
